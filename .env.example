# =========================================================================
# CONFIGURAÇÃO DO FACE PLATFORM
# =========================================================================
# Este arquivo exemplifica as variáveis de ambiente e as configurações 
# que podem ser ajustadas no sistema (atualmente o sistema as lê 
# prioritariamente do config.json, mas você pode definir a variável abaixo 
# para apontar para outro arquivo json se desejar).

# Caminho para o arquivo de configuração JSON
FACE_PLATFORM_CONFIG=config.json

# Abaixo está a explicação das chaves dentro do config.json:

# [camera]
# index: 0                  # O índice da câmera (0 é a webcam padrão)
# resolution: [1280, 720]   # Resolução da captura de vídeo (Largura x Altura)
# frame_rate: 30            # Taxa de quadros desejada

# [models]
# detection_backend: yunet            # Qual detector de rostos usar (ex: yunet, opencv, retinaface)
# recognition_backend: insightface    # Qual modelo de extração de características (embeddings) usar
# recognition_threshold: 0.5          # Nível de confiança mínimo (similaridade de cosseno) para considerar a mesma pessoa

# [database]
# location: sqlite:///face_platform.db # Caminho para o banco de dados. Pode ser alterado para PostgreSQL ou MySQL usando a string do SQLAlchemy.

# [system]
# logging_level: INFO       # Nível de detalhes dos logs (DEBUG, INFO, WARNING, ERROR)
# thread_count: 4           # Número de threads para processamento paralelo de inferência
